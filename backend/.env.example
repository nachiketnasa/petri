# Copy to .env and edit. Loaded automatically on startup (see app/db.py).
# Any SQLAlchemy connection URL works — the store (app/store.py) only ever
# talks to SQLAlchemy's engine/session API, never anything SQLite-specific.

# Default: a local SQLite file.
DATABASE_URL=sqlite:///./petri.db

# Postgres later, once you `uv add psycopg[binary]`:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/petri
